views:
  - type: table
    name: View
    filters:
      and:
        - Class == "Digital Media"
    order:
      - file.name
      - Subclass
      - Surface usability
      - Durability
  - type: cards
    name: View 2
    filters:
      and:
        - Class == "Digital Media"
    order:
      - file.name
      - Product image
      - Brand Name
      - Surface usability
    image: note.Product image
